				{
					"name": "login_username",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"var jsonData = pm.response.json();\r",
									"pm.environment.set(\"access_token\", jsonData.data.access_token);\r",
									"pm.environment.set(\"refresh_token\", jsonData.data.refresh_token);\r",
									"\r",
									"\r",
									"pm.test(\"Response time is less than 200ms\", function () {\r",
									"  pm.expect(pm.response.responseTime).to.be.below(200);\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Validate the response schema for fields: code, status, message, data, access_token, and refresh_token\", function () {\r",
									"  const responseData = pm.response.json();\r",
									"  \r",
									"  pm.expect(responseData).to.be.an('object');\r",
									"  pm.expect(responseData).to.have.property('code');\r",
									"  pm.expect(responseData).to.have.property('status');\r",
									"  pm.expect(responseData).to.have.property('message');\r",
									"  pm.expect(responseData).to.have.property('data');\r",
									"  pm.expect(responseData.data).to.have.property('access_token');\r",
									"  pm.expect(responseData.data).to.have.property('refresh_token');\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
